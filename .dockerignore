# Keep the build context small and free of local state and secrets.
# Build context = repository root (both service Dockerfiles).
**/build/
# Exception: the installed services, used only by `make up-fast` (APP_SOURCE=app-from-host).
!documentation-service/build/install/
!alert-service/build/install/
**/.gradle/
**/.kotlin/
.idea/
*.iml
out/
.git
.gitignore
*.log
.env
.env.*
!.env.example
.DS_Store
# Not needed inside the images. The Dockerfiles copy only the Gradle build files and the src/ trees of the modules
# they build, so everything below would only make the context larger (and every build upload it again).
docs/
pacts/
deploy/
scripts/
postman/
load-test/
.github/
README.md
Makefile
docker-compose.yml
.editorconfig
# JVM diagnostics can contain personal data from memory.
*.hprof
*.jfr
