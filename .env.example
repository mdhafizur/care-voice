# CareVoice configuration for docker compose and `make run-*` (CONTRACTS section 4).
#   cp .env.example .env
# .env is git-ignored. Every value below is a DUMMY for local development; never reuse them anywhere else.
#
# docker-compose.yml builds the connection URLs (DATABASE_URL, MONGO_URI, RABBITMQ_URL, REDIS_URL, ALERT_SERVICE_URL)
# from the credentials below and the compose service names, and sets *_MIGRATE_ON_STARTUP=false (the migrate one-shots
# run migrations). The URL values further down are for `make run-documentation` / `make run-alert` on the host.

# ---- Infrastructure credentials (read by docker-compose.yml) -------------------------------------------------------
POSTGRES_DB=carevoice
POSTGRES_USER=carevoice
POSTGRES_PASSWORD=carevoice-dev-password
RABBITMQ_USER=carevoice
RABBITMQ_PASSWORD=carevoice-dev-password
RABBITMQ_VHOST=carevoice

# ---- Shared by both services ---------------------------------------------------------------------------------------
# HS256 shared secret, at least 32 bytes. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
JWT_ISSUER=carevoice-auth
JWT_AUDIENCE=carevoice
RATE_LIMIT_PER_MINUTE=120

# ---- documentation-service -----------------------------------------------------------------------------------------
# Used by `make run-documentation` (host); docker compose overrides these with the container addresses.
DATABASE_URL=jdbc:postgresql://localhost:5432/carevoice
DATABASE_USER=carevoice
DATABASE_PASSWORD=carevoice-dev-password
DATABASE_POOL_SIZE=10
# Optional: direct connection for Flyway when DATABASE_URL goes through PgBouncer (not used in compose).
# DATABASE_MIGRATION_URL=
# Optional: set 0 behind PgBouncer < 1.21 in transaction mode.
# DATABASE_PREPARE_THRESHOLD=
REDIS_URL=redis://localhost:6379
ALERT_SERVICE_URL=http://localhost:8081

# AES-256-GCM key: base64 of exactly 32 random bytes. Generate one with:
#   openssl rand -base64 32
DATA_ENCRYPTION_KEY=ZHVtbXkta2V5LWRvLW5vdC11c2UtaW4tcHJvZC0zMmI=
DATA_ENCRYPTION_KEY_ID=v1
JWT_TTL_SECONDS=900
TRANSCRIPT_RETENTION_DAYS=30

# amqp = RabbitMQ (default), http = direct POST to alert-service
EVENT_TRANSPORT=amqp

# AI (documentation-service fallback when the rules find nothing, alert-service guidance). AI_PROVIDER picks the
# model API: claude (ANTHROPIC_API_KEY, AI_MODEL) or gemini (GEMINI_API_KEY, GEMINI_MODEL). Keys are needed only for
# the features that are enabled. Never paste a key into a command line: it ends up in the shell history.
AI_FALLBACK_ENABLED=false
AI_PROVIDER=claude
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# gemini-flash-latest is the busiest alias and answers 503 UNAVAILABLE under high demand; a lite model such as
# gemini-3.5-flash-lite is faster and plenty for reading numbers. List what your key can use: see docs/local-access.md.
# Gemini 3 models think before answering; low is the cheapest level 3.8 Flash accepts. none = no thinkingConfig
# (required for Gemini 2.5 models).
GEMINI_THINKING_LEVEL=low
# Per-attempt timeout of the extraction fallback in ms (500-30000). Default: 3000 for Claude, 5000 for Gemini.
# The nurse waits for it; when the AI never answers in time, the logs show "AI extraction finished" result=timeout.
# AI_TIMEOUT_MS=5000

# Seeds the demo tenant, wards, residents and users (nurse.anna, nurse.ben, lead.clara); password >= 8 characters.
DEMO_SEED_ENABLED=true
DEMO_PASSWORD=demo-password-change-me

# ---- alert-service -------------------------------------------------------------------------------------------------
# Quoted because of the '&' (the Makefile sources this file with the shell). directConnection: the replica set member
# is registered as mongo:27017, which the host cannot resolve.
MONGO_URI='mongodb://localhost:27017/?replicaSet=rs0&directConnection=true'
MONGO_DATABASE=carevoice_alerts
RABBITMQ_PREFETCH=32

# ---- Both services: RabbitMQ (documentation-service publishes, alert-service consumes) -----------------------------
RABBITMQ_URL=amqp://carevoice:carevoice-dev-password@localhost:5672/carevoice

# Local domain for host-based routing through Traefik on port 80 (api., alerts., grafana., status.<domain>).
# nip.io resolves *.127.0.0.1.nip.io to 127.0.0.1 (needs internet for DNS). Offline alternative: carevoice.localhost
CAREVOICE_DOMAIN=carevoice.127.0.0.1.nip.io
# Host port for those names (default 80). Use e.g. 8000 when another program already listens on port 80.
CAREVOICE_HTTP_PORT=80

# Log level of the application code (com.carevoice.*) in both services: TRACE, DEBUG, INFO, WARN, ERROR.
# Libraries keep their own levels (INFO/WARN), so DEBUG does not flood the logs with Netty or driver output.
# docker compose defaults to DEBUG; production stays at INFO (never DEBUG in production).
# CAREVOICE_LOG_LEVEL is still read when LOG_LEVEL is unset.
LOG_LEVEL=DEBUG

# Postgres statement logging in docker compose: none (default) or mod (every INSERT/UPDATE/DELETE, for debugging).
# Queries slower than 500 ms are always logged; parameter values never are.
POSTGRES_LOG_STATEMENT=none

# Local admin UIs (make monitoring-up / make admin-up). Change for anything beyond a laptop.
KUMA_USERNAME=admin
KUMA_PASSWORD=carevoice-admin-1
PGADMIN_PASSWORD=carevoice-admin-1
MONGO_EXPRESS_PASSWORD=carevoice-admin-1

# Protocol guidance for alerts (alert-service, ADR-0023). Defaults work offline: local hashing embeddings and the
# protocol's own steps. GUIDANCE_EMBEDDER=voyage needs VOYAGE_API_KEY, =gemini needs GEMINI_API_KEY;
# GUIDANCE_AI_ENABLED=true needs the key of AI_PROVIDER (the LLM phrases the steps, every step must cite a section).
GUIDANCE_EMBEDDER=hashing
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
VOYAGE_API_KEY=
GUIDANCE_AI_ENABLED=false
